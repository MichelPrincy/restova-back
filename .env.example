ENV=development

# --- Base de données ---
# PostgreSQL local (docker compose up -d db) :
DATABASE_URL=postgresql://postgres.ldccbaapwmsdswobsexa:XnyMichelPrincy.2709@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Plus tard, Supabase : coller ici la chaîne « Connection string » du projet, ex.
#   direct (IPv6)        : postgresql://postgres:MOT_DE_PASSE@db.<ref>.supabase.co:5432/postgres
#   session pooler (IPv4): postgresql://postgres.<ref>:MOT_DE_PASSE@aws-0-<region>.pooler.supabase.com:5432/postgres
# (le transaction pooler, port 6543, est aussi géré automatiquement)

# Crée les tables au démarrage (dev/SQLite seulement). En prod : `alembic upgrade head`.
AUTO_CREATE_TABLES=false

# --- Sécurité ---
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# --- Front / CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.1.67:3000
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000

# --- Métier ---
TAX_RATE=0
ORDERS_LIST_MAX=500
REQUIRE_PAYMENT_BEFORE_PREPARATION=false

# --- Paiement ---
PAYMENT_PROVIDER=mock
# Secret HMAC du webhook (vide = webhook désactivé)
PAYMENT_WEBHOOK_SECRET=
